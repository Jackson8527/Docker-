# Python / uv
__pycache__/
*.py[cod]
.venv/
# NOTE: uv.lock is deliberately COMMITTED, not ignored. backend/Dockerfile does
# `COPY pyproject.toml uv.lock ./` then `uv sync --frozen`, so a fresh clone
# must contain it - a local build only succeeds because the file happens to sit
# on disk. This mirrors frontend/package-lock.json, which is committed too.
dist/
build/

# Node
node_modules/
frontend/dist/
frontend/node_modules/
.npm-cache/

# build/vite artifacts
frontend/vite.config.js
frontend/vite.config.d.ts
frontend/*.tsbuildinfo

# Env / local
.env
*.local

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# DSH / temp
*.tmp
_tmp_*

# pytest
.pytest_cache/
pytest-cache-files-*

